PORT=3000
APP_ORIGIN=http://localhost:3000

# Public Firebase web-app configuration (not a secret; restrict the API key in Google Cloud).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Keep the AI API key on the server only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Use Application Default Credentials or a JSON service-account secret.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
